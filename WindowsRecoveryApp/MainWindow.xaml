<Window x:Class="WindowsRecoveryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Recovery App" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="Windows Recovery &amp; Repair Tool" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Automated Repair Section -->
        <GroupBox Grid.Row="1" 
                  Header="Automated System Repair" 
                  Foreground="White"
                  BorderBrush="#FF4A4A4A"
                  Margin="0,0,0,20">
            <StackPanel Margin="10">
                <TextBlock Text="Scan and repair Windows system issues automatically" 
                           Foreground="LightGray"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <Button x:Name="btnQuickScan" 
                            Content="Quick Scan &amp; Fix" 
                            Width="150" 
                            Height="35"
                            Background="#FF0078D4"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="QuickScan_Click"/>
                    <Button x:Name="btnFullScan" 
                            Content="Full System Scan" 
                            Width="150" 
                            Height="35"
                            Margin="10,0,0,0"
                            Background="#FF0078D4"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="FullScan_Click"/>
                    <Button x:Name="btnFixExplorer" 
                            Content="Fix Explorer Issues" 
                            Width="150" 
                            Height="35"
                            Margin="10,0,0,0"
                            Background="#FF107C10"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="FixExplorer_Click"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Output Log -->
        <GroupBox Grid.Row="2" 
                  Header="Operations Log" 
                  Foreground="White"
                  BorderBrush="#FF4A4A4A"
                  Margin="0,0,0,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="txtLog" 
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Background="#FF2D2D2D"
                         Foreground="LightGray"
                         BorderThickness="0"
                         Padding="10"
                         FontFamily="Consolas"
                         VerticalScrollBarVisibility="Auto"/>
            </ScrollViewer>
        </GroupBox>

        <!-- Quick Access Tools -->
        <GroupBox Grid.Row="3" 
                  Header="Quick Access Tools" 
                  Foreground="White"
                  BorderBrush="#FF4A4A4A">
            <StackPanel Margin="10">
                <TextBlock Text="Quick access to useful Windows tools and scripts" 
                           Foreground="LightGray"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>
                
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnMASScript" 
                            Content="Microsoft Activation Scripts" 
                            Width="200" 
                            Height="35"
                            Background="#FFE74856"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="MASScript_Click"/>
                    <Button x:Name="btnChrisTitus" 
                            Content="Chris Titus Tech Tools" 
                            Width="200" 
                            Height="35"
                            Margin="10,0,0,0"
                            Background="#FFE74856"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ChrisTitus_Click"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
